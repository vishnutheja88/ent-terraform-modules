{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ent-terraform-modules environment values",
  "type": "object",
  "additionalProperties": false,
  "required": ["env", "region"],
  "$defs": {
    "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$" },
    "arn": { "type": "string", "pattern": "^arn:aws[a-z-]*:[a-z0-9-]+:[a-z0-9-]*:([0-9]{12}|aws)?:.+$" }
  },
  "properties": {
    "env": { "type": "string", "pattern": "^[a-z0-9-]{2,20}$" },
    "region": { "type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$" },
    "name_prefix": { "type": "string", "pattern": "^[a-z0-9-]{2,10}$" },
    "account_role": { "type": "string", "pattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$" },
    "tags": { "type": "object", "additionalProperties": { "type": "string" } },

    "existing_network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vpc_id"],
      "properties": {
        "vpc_id": { "type": "string", "pattern": "^vpc-[0-9a-f]+$" },
        "private_subnet_ids": { "type": "array", "items": { "type": "string", "pattern": "^subnet-[0-9a-f]+$" } },
        "public_subnet_ids": { "type": "array", "items": { "type": "string", "pattern": "^subnet-[0-9a-f]+$" } }
      }
    },

    "vpc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "cidr": { "$ref": "#/$defs/cidr" },
        "az_count": { "type": "integer", "minimum": 1, "maximum": 4 },
        "nat_gateway": { "type": "boolean" },
        "single_nat_gateway": { "type": "boolean" },
        "flow_logs": { "type": "boolean" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["cidr"] }
    },

    "igw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },

    "ec2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "public": { "type": "boolean" },
        "instance_type": { "type": "string", "enum": ["t3.micro", "t3.small", "t3.medium", "t3.large", "m6i.large", "m6i.xlarge"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 10 },
        "ami_id": { "type": "string", "pattern": "^ami-[0-9a-f]+$" },
        "root_volume_gb": { "type": "integer", "minimum": 8, "maximum": 500 },
        "ingress_ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
        "ingress_cidrs": { "type": "array", "items": { "$ref": "#/$defs/cidr" } }
      }
    },

    "iam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "permissions_boundary_arn": { "$ref": "#/$defs/arn" },
        "roles": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9-]{2,40}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string" },
              "trusted_services": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.amazonaws\\.com$" } },
              "trusted_role_arns": { "type": "array", "items": { "$ref": "#/$defs/arn" } },
              "instance_profile": { "type": "boolean" },
              "policy_arns": { "type": "object", "additionalProperties": { "$ref": "#/$defs/arn" } }
            },
            "anyOf": [
              { "required": ["trusted_services"] },
              { "required": ["trusted_role_arns"] }
            ]
          }
        }
      }
    },

    "route53": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "zone_name": { "type": "string", "pattern": "^([a-z0-9-]+\\.)+[a-z]{2,}$" },
        "private": { "type": "boolean" },
        "records": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["A", "AAAA", "CNAME", "TXT", "MX", "SRV"] },
              "ttl": { "type": "integer", "minimum": 30 },
              "records": { "type": "array", "items": { "type": "string" } },
              "alias": {
                "type": "object",
                "required": ["name", "zone_id"],
                "properties": {
                  "name": { "type": "string" },
                  "zone_id": { "type": "string" },
                  "evaluate_target_health": { "type": "boolean" }
                }
              }
            }
          }
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["zone_name"] }
    },

    "eks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "version": { "type": "string", "pattern": "^1\\.[0-9]{2}$" },
        "public_endpoint": { "type": "boolean" },
        "public_endpoint_cidrs": { "type": "array", "items": { "$ref": "#/$defs/cidr" } },
        "node_groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instance_types": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "capacity_type": { "type": "string", "enum": ["ON_DEMAND", "SPOT"] },
              "ami_type": { "type": "string" },
              "min_size": { "type": "integer", "minimum": 0 },
              "max_size": { "type": "integer", "minimum": 1, "maximum": 50 },
              "desired_size": { "type": "integer", "minimum": 0 },
              "disk_size": { "type": "integer", "minimum": 20 },
              "labels": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "extra_addons": { "type": "object" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["version"] }
    }
  }
}
